{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch WebApi",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/src/Host/bin/Debug/net9.0/Host.dll",
            "args": [],
            "cwd": "${workspaceFolder}/src/Host",
            "stopAtEntry": false,
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            },
            "sourceFileMap": {
                "/Views": "${workspaceFolder}/Views"
            }
        },
        {
            "name": "Attach to WebApi",
            "type": "coreclr",
            "request": "attach"
        }
    ]
}